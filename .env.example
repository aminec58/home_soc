# Modèle — copier en .env et remplir (le .env n'est PAS versionné)
#
# IMPORTANT : ce fichier ne contient JAMAIS de vraie valeur, il sert
# uniquement à documenter quels secrets existent et où les retrouver.
# Les scripts d'installation génèrent les secrets et les écrivent dans
# /root/<service>-credentials.txt sur la VM concernée, hors du dépôt.

# --- VM wazuh (192.168.56.10) ---
# Dashboard : https://192.168.56.10
WAZUH_ADMIN_PASSWORD=

# --- VM elastic (192.168.56.20) ---
# Générés par install/elastic.sh → /root/elastic-credentials.txt
# Compte "elastic" (mot de passe créé par Elasticsearch à l'installation)
ELASTIC_PASSWORD=
# Compte de service kibana_system (géré par le jeton d'enrôlement)
KIBANA_PASSWORD=

# --- VM thehive (192.168.56.30) ---
# Générés par install/thehive.sh → /root/thehive-credentials.txt
# play.http.secret.key de TheHive — 64 caractères hexa (256 bits minimum)
THEHIVE_SECRET=
# play.http.secret.key de Cortex — 64 caractères hexa
CORTEX_SECRET=
# Clé API d'un utilisateur Cortex ayant les rôles read + analyze
# (un compte superadmin ne peut PAS lister les analyseurs)
CORTEX_API_KEY=
# Compte admin@thehive.local (mot de passe par défaut "secret" à changer)
THEHIVE_ADMIN_PASSWORD=
# Compte admin@cortex.local
CORTEX_ADMIN_PASSWORD=

# --- TLS (HOMESOC-11) ---
# Mots de passe des keystores PKCS12 de TheHive et Cortex
THEHIVE_KEYSTORE_PASSWORD=
CORTEX_KEYSTORE_PASSWORD=
